pipeline {
    agent any 
    stages {
        stage ("Clean workspace") {
            steps {
                cleanWs()
            }
        }
    stage ("code") {
        steps {
            git branch: 'node', 
                    url: 'https://github.com/avinashdevops0/Micro-services_Applications.git'
        }
    }
    stage ("Build Images") {
        steps {
            sh "docker build -t -n api-gateway-image:latest ./api-gateway"
            sh "docker build -t frontend-image:latest ./frontend"
            sh "docker build -t database-image-bookings:latest ./services/bookings/database"
            sh "docker build -t bookings-image:latest ./services/bookings"
        }
    }
    stage ("Removing containers") {
        steps {
            sh "docker rm -f frontend || true"
            sh "docker rm -f api-gateway || true"
            sh "docker rm -f bookingsdb || true"
            sh "docker rm -f bookings-service || true"
        }
    }
    stage ("Creating network") {
        steps {
            sh "docker network create microservices || true"
        }
    }

    stage ("Running containers") {
        steps {
            sh "docker run -d --name api-gateway --network microservices api-gateway-image:latest"
            sh "sleep 5"
            sh "docker run -d -p 80:80 --name frontend --network microservices frontend-image:latest"
            sh "sleep 5"
            sh "docker run -itd --name bookingsdb --network microservices database-image-bookings:latest"
            sh "sleep 5"
            sh "docker run -itd --name bookings-service --network microservices bookings-image:latest"

        }
    }
    stage (" clean up") {
        steps {
            sh "docker image prune -f"
        }
    }
    }
}